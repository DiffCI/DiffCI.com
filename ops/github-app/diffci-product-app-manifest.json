{
  "name": "DiffCI",
  "url": "https://diffci.com",
  "description": "Read-only change-aware CI observation, repository discovery, and reports. DiffCI never writes to your repository, skips tests, cancels runs, or changes required checks.",
  "public": true,
  "default_permissions": {
    "metadata": "read",
    "contents": "read",
    "actions": "read",
    "checks": "read"
  },
  "default_events": ["installation", "installation_repositories", "push", "workflow_run"],
  "hook_attributes": {
    "url": "https://app.diffci.com/v1/webhooks/github",
    "active": true
  },
  "redirect_url": "https://app.diffci.com/auth/github/callback",
  "setup_url": "https://app.diffci.com/app/install/callback",
  "setup_on_update": false,
  "request_oauth_on_install": false
}
