/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY

# Versioned permalinks (docs/website/permalinks.md). A -vN file is never edited or moved, so it is
# safe to cache for a year; a correction ships as -v(N+1) at a new URL and the old one stays.
# Cloudflare _headers has no character classes, so each version gets its own rule.
/research/2026/*-v1.pdf
  Cache-Control: public, max-age=31536000, immutable
/research/2026/*-v2.pdf
  Cache-Control: public, max-age=31536000, immutable
