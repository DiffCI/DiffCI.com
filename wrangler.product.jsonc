{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "diffci-product",
  "main": "./src/product/cloudflare/product-worker.ts",
  "compatibility_date": "2026-08-20",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  // Pinned explicitly (2026-08-22) now that this account holds a second zone (diffci.com, added
  // alongside dentalpresence.in) - was previously implicit (this account was the only one the wrangler
  // OAuth token could resolve to), so pinning changes nothing about where this already deploys, it just
  // stops relying on that being true by accident now that there's more than one zone to disambiguate.
  "account_id": "571ba9bf90457be28a492d139c055e54",
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  // Custom-domain route deliberately NOT added below even though diffci.com now exists as a zone in this
  // account (2026-08-22) - this Worker is still "not production-ready yet" per Part 5/28 (see the
  // DIFFCI_ENVIRONMENT comment just below), and going live on the apex domain is a product decision, not
  // a DNS one. Uncomment when actually ready to serve production traffic on diffci.com:
  // "routes": [{ "pattern": "diffci.com/*", "custom_domain": true }],
  //
  // DIFFCI_ENVIRONMENT="production" is the correct value here even though this deploys only to the
  // workers.dev subdomain (no custom domain/route configured - Part 5/28: "not production-ready yet",
  // "routes/domains only if appropriate"). DIFFCI_ENVIRONMENT governs AUTH SECURITY POSTURE
  // (src/auth/config.ts parseAuthConfig), not public-announcement status - it must be "production" so
  // DIFFCI_ALLOW_DEV_HEADER_AUTH can never be combined with it (parseAuthConfig() throws and the Worker
  // refuses to serve ANY request if that illegal combination is ever configured - see Part 10/3).
  // DIFFCI_ALLOW_DEV_HEADER_AUTH is deliberately ABSENT from vars entirely, not set to "false" - its
  // absence is what proves no deploy process could have silently left the dev-header path enabled.
  "vars": {
    "DIFFCI_PRODUCT_ENABLED": "true",
    "DIFFCI_ENVIRONMENT": "production",
    "DIFFCI_SESSION_TTL_MS": "2592000000", // 30 days
    // Points the runner-provider selection (product-worker.ts runnerProviderFromEnv) at the real
    // deployed Cloudflare Containers runner (Part 15/16) - RUNNER_CONTROL_TOKEN (secret, not here) must
    // match the value configured on wrangler.synthetic-runner.jsonc for this to resolve to the real
    // provider instead of falling back to the mock.
    // Real, currently-inert fallback for asyncRunnerProviderFromEnv()'s isConfigured() check and for
    // any external/local script that talks to synthetic-runner directly - the actual R1 runtime calls
    // go through the "services" binding below, never this URL, once it's configured (Cloudflare blocks
    // a Worker from fetch()-ing another Worker's own workers.dev URL outright - error 1042, confirmed
    // live - so a raw URL fetch from WITHIN this deployed Worker would never actually succeed).
    "SYNTHETIC_RUNNER_URL": "https://diffci-synthetic-runner.damp-waterfall-0cd8.workers.dev",
    // R1 (Real Runner): this Worker's own public base URL, injected into every real runner container so
    // its bootstrap script knows where to call back (register/claim/result - src/runner/agent-api.ts).
    // No custom domain configured yet (see the comment above), so this IS the real reachable address.
    "DIFFCI_API_ORIGIN": "https://diffci-product.damp-waterfall-0cd8.workers.dev",
    "DIFFCI_ENVIRONMENT_LABEL": "staging"
  },
  // Part 22: runs scheduled() (orphan-runner cleanup) every 10 minutes - same cadence as Stage 2F's own
  // shadow-poll cron (wrangler.research-sandbox.jsonc), chosen for consistency, not because runner
  // orphaning specifically needs sub-10-minute detection (the shortest configured timeout,
  // maxProvisioningMs, is 5 minutes - see src/runner/cleanup.ts DEFAULT_TIMEOUT_CONFIG).
  "triggers": {
    "crons": ["*/10 * * * *"]
  },
  // R1: real Worker-to-Worker call to diffci-synthetic-runner - a Cloudflare Service Binding (in-process
  // call), NOT a fetch() to that Worker's own workers.dev URL (blocked outright, error 1042 - see the
  // SYNTHETIC_RUNNER_URL comment above). Same pattern already proven for diffci-preflight ->
  // diffci-github-runner.
  "services": [{ "binding": "SYNTHETIC_RUNNER_WORKER", "service": "diffci-synthetic-runner" }],
  "d1_databases": [
    // Writable - this Worker owns diffci-product (accounts/billing/sessions/usage/runners/queue/audit).
    { "binding": "PRODUCT_DB", "database_name": "diffci-product", "database_id": "b3951dbd-e253-46bf-907e-ae07d0998aa5" },
    // READ-ONLY BY CODE DISCIPLINE, not by D1 permission (D1 bindings have no read-only mode). Every
    // query against this binding must go through src/product/shadow-read-boundary.ts, which issues only
    // SELECT statements - see that file's header comment (Part 20). This Worker must NEVER write to
    // diffci-research; that database belongs to Stage 2F's frozen shadow/research pipeline.
    { "binding": "RESEARCH_DB", "database_name": "diffci-research", "database_id": "84ddc2e5-0f1d-424f-8bfc-81f4e39dc534" }
  ]
  // Secrets (NOT committed here - set via `wrangler secret put <NAME> --config wrangler.product.jsonc`):
  //   LEMONSQUEEZY_API_KEY, LEMONSQUEEZY_WEBHOOK_SECRET, LEMONSQUEEZY_STORE_ID  - billing (Part 12/13,
  //     deferred per this build's own scoping decision - not yet configured, checkout/portal/webhook
  //     routes correctly return 503 "billing is not configured" until they are)
  //   LEMONSQUEEZY_VARIANT_IDS - optional JSON, e.g. '{"developer":"123"}'
  //   GITHUB_OAUTH_CLIENT_ID, GITHUB_OAUTH_CLIENT_SECRET - GitHub OAuth App credentials (Part 6) - see
  //     docs/product/2026-08-22-github-oauth-app-registration.md for the exact registration steps
  //   CSRF_SECRET - signs the double-submit CSRF token (Part 9); generate with
  //     `openssl rand -base64 32` or equivalent, never reused across environments
}
