{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "diffci-synthetic-runner",
  "main": "./src/runner/cloudflare/synthetic-runner-worker.ts",
  "compatibility_date": "2026-08-20",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  // Pinned explicitly (2026-08-22) - see wrangler.product.jsonc's account_id comment for the full
  // rationale (this account now holds two zones: dentalpresence.in and diffci.com).
  "account_id": "571ba9bf90457be28a492d139c055e54",
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  // No custom-domain route: this Worker exists to prove the container-orchestration model (Part 12), not
  // to serve any public surface - workers.dev is the right home for it regardless of diffci.com's zone.
  "containers": [
    {
      "class_name": "SyntheticRunner",
      // Cloudflare's own pre-published Sandbox image - the SAME image diffci-research-sandbox already
      // uses (wrangler.research-sandbox.jsonc). Deliberately NOT a custom Dockerfile: building one
      // requires a local Docker daemon, which was unavailable when this was built - a real, live-tested
      // deploy attempt against a custom Dockerfile failed with "The Docker CLI is needed... could not be
      // launched", while this public-image reference deployed successfully with no local build step at
      // all (Cloudflare pulls it directly). This Worker is otherwise fully separate from
      // diffci-research-sandbox - its own Worker, its own Durable Object class, no shared binding, no
      // Stage 2F file touched to build it.
      "image": "docker.io/cloudflare/sandbox:0.12.5",
      // Briefly bumped to "standard-2" on 2026-08-22 to diagnose real GH-runner-registration timeouts
      // seen while validating diffci-github-runner's Sandbox pivot on this same Worker (a convenient
      // throwaway testbed, since this Worker's actual job is unrelated trivial echo commands). Root
      // cause confirmed: "lite" is too CPU/network-constrained for a download+tar+installdependencies.sh
      // sequence - reliably 3-10x slower and prone to exec() timeouts, vs. a clean ~26s total on
      // "standard-2". Reverted back to "lite" now that the diagnosis is done and applied to
      // wrangler.github-runner.jsonc, which is where standard-2 actually belongs (Part 19's synthetic
      // jobs here stay trivial and don't need it).
      "instance_type": "lite",
      "max_instances": 3, // low ceiling deliberately - this Worker exists to prove the orchestration model (Part 12), not to run production workload volume
      "rollout_step_percentage": [100]
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "SYNTHETIC_RUNNER", "class_name": "SyntheticRunner" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SyntheticRunner"] }]
  // Secret (NOT committed here): RUNNER_CONTROL_TOKEN - set via
  //   `wrangler secret put RUNNER_CONTROL_TOKEN --config wrangler.synthetic-runner.jsonc`
  // The SAME value must also be configured on the product Worker (as the CloudflareContainerRunnerProvider's
  // controlToken) so it can call this Worker's control surface.
}
