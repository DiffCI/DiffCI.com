{
  // The public site at diffci.com. Static assets only - no Worker script, no bindings, no secrets.
  // Deliberately its own Worker: this is the one internet-facing surface with no access to D1, R2,
  // GitHub App keys, or any research/runner state, and it should stay that way.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "diffci-site",
  // Held at a date the locally-installed wrangler's workerd binary supports, so `npm run site:dev`
  // works offline. Irrelevant to behaviour here - this Worker runs no code, it only serves files.
  "compatibility_date": "2026-08-08",
  // 2026-09-05: a script in front of the assets for http->https and www->apex redirects only
  // (src/site/site-worker.ts); every other request is served from ./site unchanged.
  "main": "./src/site/site-worker.ts",
  "assets": {
    "binding": "ASSETS",
    // Without this, a request that matches an asset is served without ever invoking the script - the
    // http->https and www->apex redirects would never run (observed 2026-09-05: http:// answered 200).
    "run_worker_first": true,
    "directory": "./site",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "observability": {
    "enabled": true
  },
  // Adding "routes" makes wrangler default workers_dev to false - keep it explicitly on so the
  // existing workers.dev URL (referenced elsewhere, and useful as a fallback) stays live regardless
  // of custom-domain/DNS state.
  "workers_dev": true,
  // Founder-authorized 2026-09-04: point the live domain at this Worker. custom_domain:true has
  // wrangler provision the DNS record itself (the zone was already active on Cloudflare beforehand,
  // independent of this repo). The remaining site TODOs (legal entity, contact, the deletion path
  // promised in data-handling.html) are still open - authorized to go live with them still open.  // Resolved 2026-09-04: the founder cleared a pre-existing externally-managed apex record that had
  // blocked custom-domain provisioning (error 100117); the route now attaches cleanly on deploy.
  // Still founder-owned (Cloudflare dashboard, not this file): "Always Use HTTPS" for the zone (plain
  // http:// currently serves the page without redirecting) and a www record (www.diffci.com returns 522).
  "routes": [
    { "pattern": "diffci.com", "custom_domain": true },
    // 2026-09-05: www used to 522. The hostname already has an externally managed DNS record (Cloudflare
    // refuses a custom domain over it, code 100117), so the Worker is attached as a ROUTE on that record and
    // redirects to the apex. If the record is ever removed, switch this back to custom_domain: true.
    { "pattern": "www.diffci.com/*", "zone_name": "diffci.com" }
  ]
}
