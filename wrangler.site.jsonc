{
  // The public site at diffci.com. Static assets only - no Worker script, no bindings, no secrets.
  // Deliberately its own Worker: this is the one internet-facing surface with no access to D1, R2,
  // GitHub App keys, or any research/runner state, and it should stay that way.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "diffci-site",
  // Held at a date the locally-installed wrangler's workerd binary supports, so `npm run site:dev`
  // works offline. Irrelevant to behaviour here - this Worker runs no code, it only serves files.
  "compatibility_date": "2026-08-08",
  "assets": {
    "directory": "./site",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "observability": {
    "enabled": true
  },
  // Adding "routes" makes wrangler default workers_dev to false - keep it explicitly on so the
  // existing workers.dev URL (referenced elsewhere, and useful as a fallback) stays live regardless
  // of custom-domain/DNS state.
  "workers_dev": true,
  // Founder-authorized 2026-09-04: point the live domain at this Worker. custom_domain:true has
  // wrangler provision the DNS record itself (the zone was already active on Cloudflare beforehand,
  // independent of this repo). The remaining site TODOs (legal entity, contact, the deletion path
  // promised in data-handling.html) are still open - authorized to go live with them still open.
  // BLOCKED as of 2026-09-04: diffci.com already has an externally-managed DNS record (A/CNAME) at
  // the apex, and this account's API token lacks DNS-record read/write scope to inspect or clear it.
  // Custom-domain provisioning fails until that record is removed - see chat for what's needed.
  "routes": [
    { "pattern": "diffci.com", "custom_domain": true }
  ]
}
