{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "diffci-github-runner",
  "main": "./src/research/cloudflare/github-runner-worker.ts",
  "compatibility_date": "2026-08-20",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  // Pinned explicitly (2026-08-22) - see wrangler.product.jsonc's account_id comment for the full
  // rationale (this account now holds two zones: dentalpresence.in and diffci.com).
  "account_id": "571ba9bf90457be28a492d139c055e54",
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  // Custom-domain route added 2026-08-22 now that diffci.com is an active zone in this account.
  // GitHub's `workflow_job` webhook (Runner Dispatcher App) has been cut over to
  // https://runner.diffci.com/webhook - live-verified: a real post-cutover delivery got a 202 and its CI
  // job ran to completion (see docs/github-app-registration-runner.md). The old workers.dev URL is left
  // deployed (removing it isn't necessary and Workers can answer on multiple hostnames at once) but
  // GitHub no longer calls it.
  "routes": [{ "pattern": "runner.diffci.com", "custom_domain": true }],
  // 2026-09-05 (repair step 4): dispatch runs from a Queue consumer, never from the webhook handler's
  // ctx.waitUntil() (cancelled ~30 s after the response - the live tail showed every dispatch
  // "canceled" at 29.6 s with no record of the runner's fate). One message per GitHub job; the consumer
  // owns the whole runner lifecycle (<= 10 min exec inside the 15-minute consumer limit). max_retries
  // 2 with the consumer's own delayed retry on a capacity/start failure; a deterministic failure is
  // stopped by MAX_DISPATCH_ATTEMPTS in runner-dispatch.ts and stays visible in runner_job_lifecycle.
  "queues": {
    "producers": [{ "binding": "RUNNER_DISPATCH_QUEUE", "queue": "diffci-runner-dispatch" }],
    "consumers": [{ "queue": "diffci-runner-dispatch", "max_batch_size": 1, "max_batch_timeout": 0, "max_retries": 2, "max_concurrency": 3 }]
  },
  // Lifecycle provenance lives in the same D1 as the shadow tables (runner_job_lifecycle,
  // runner_job_events) so one query joins "which run was the evidence" with "how did its runner live".
  "d1_databases": [
    { "binding": "RUNNER_DB", "database_name": "diffci-research", "database_id": "84ddc2e5-0f1d-424f-8bfc-81f4e39dc534" }
  ],
  // Reconciler: every 5 minutes, queued jobs that never got a dispatch, whose dispatch failed, or whose
  // dispatch went stale are re-enqueued (runner-dispatch.ts decideReconcileDispatches) - the safety net
  // for a lost delivery, a cancelled consumer, or the container ceiling. GitHub never re-delivers
  // workflow_job.queued, so without this a job whose first dispatch died waited 24 h and was cancelled.
  "triggers": { "crons": ["*/5 * * * *"] },
  //
  // No `vars` block for secrets - GITHUB_WEBHOOK_SECRET, GITHUB_APP_ID, and GITHUB_APP_PRIVATE_KEY are
  // set with `wrangler secret put <NAME> --config wrangler.github-runner.jsonc`, never committed here.
  // Requires a GitHub App (see docs/research on the Stage 2 App manifest for the shape) installed on
  // BOTH DiffCI.com and DentalPresence.in, with Actions:write + Administration:write repo permissions
  // (Administration:write is what lets it mint runner registration tokens) and subscribed to the
  // `workflow_job` webhook event.
  "containers": [
    {
      "class_name": "GithubRunner",
      // Cloudflare's own pre-published Sandbox image - see github-runner-worker.ts's file-header
      // comment for the full rationale (local Docker was unavailable to build ./ops/github-runner/Dockerfile,
      // a GitHub-Actions-hosted build hit a pre-existing account billing hold; this needs no build step
      // at all, confirmed by a live successful deploy of the identical image reference for
      // diffci-synthetic-runner and diffci-research-sandbox).
      "image": "docker.io/cloudflare/sandbox:0.12.5",
      "instance_type": "standard-2",
      // One running instance per in-flight job (ephemeral - each self-terminates after its one job,
      // so this bounds concurrent *running* jobs across both repos, not a standing idle pool). Raise
      // if DiffCI.com and DentalPresence.in regularly queue jobs at the same time.
      "max_instances": 5,
      "rollout_step_percentage": [100]
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "GITHUB_RUNNER", "class_name": "GithubRunner" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["GithubRunner"] }
  ]
}
